#!/usr/bin/env bash
# Launch Claude Code for a room role.
# Paseo invokes this as: claude-room <role> <claude args from the Agent SDK...>
#
# The Agent SDK sends its own system-prompt append over the init message, which
# overrides --append-system-prompt. Role instructions are therefore injected by
# a SessionStart hook passed through --settings, scoped to this launch only.
set -euo pipefail

usage="usage: claude-room <supervisor|lead> [claude args...] | claude-room --session-context <role>"

room_config="${CODEX_ROOM_CONFIG_HOME:-${HOME}/.config/codex-room}"

# Print a role's instructions: roles/<role>.md, or the developer_instructions of
# the role's Codex overlay so a Lead on Claude and on Codex share one source.
role_text() {
  local md="${room_config}/roles/$1.md" overlay="${room_config}/overlays/$1.config.toml"
  if [[ -r "$md" ]]; then
    cat "$md"
  elif [[ -r "$overlay" ]]; then
    /usr/bin/python3 -c 'import re,sys; print(re.search(r"(?ms)^developer_instructions\s*=\s*\"\"\"\n(.*?)^\"\"\"", open(sys.argv[1]).read()).group(1))' "$overlay"
  else
    echo "missing role prompt for $1" >&2; return 2
  fi
}

if [[ "${1:-}" == "--session-context" ]]; then
  role_text "${2:?$usage}" | /usr/bin/jq -Rs '{hookSpecificOutput: {hookEventName: "SessionStart", additionalContext: .}}'
  exit
fi

role="${1:?$usage}"
shift

case "$role" in
  supervisor|lead) ;;
  *) echo "unknown claude-room role: $role" >&2; exit 2 ;;
esac

role_text "$role" >/dev/null || exit 2

self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
role_settings=$(/usr/bin/jq -cn --arg cmd "'${self}' --session-context ${role}" \
  '{hooks: {SessionStart: [{hooks: [{type: "command", command: $cmd}]}]}}')

# Lead seats run without global skills or plugins (plugin hooks inject context),
# except user skills whose directory matches ROOM_SKILL_ALLOW (default: paseo*).
if [[ "$role" == lead ]]; then
  claude_home="${CLAUDE_CONFIG_DIR:-${HOME}/.claude}"
  user_settings="${claude_home}/settings.json"
  [[ -r "$user_settings" ]] || user_settings=/dev/null
  allow="${ROOM_SKILL_ALLOW:-paseo*}"
  skills_off=$(
    shopt -s nullglob
    for dir in "${claude_home}"/skills/*/; do
      name=$(basename "$dir"); keep=0
      IFS=, read -ra patterns <<<"$allow"
      for pattern in "${patterns[@]}"; do [[ "$name" == $pattern ]] && keep=1; done
      ((keep)) || printf '%s\n' "$name"
    done | /usr/bin/jq -Rn '[inputs | {key: ., value: "off"}] | from_entries'
  )
  role_settings=$(/usr/bin/jq -c --slurpfile user <(cat "$user_settings" 2>/dev/null || echo '{}') \
    --argjson off "$skills_off" '
      .enabledPlugins = ((($user[0] // {}).enabledPlugins // {}) | map_values(false))
      | .disableBundledSkills = true
      | .skillOverrides = $off' <<<"$role_settings")
fi

# The SDK passes its own --settings (last one wins), so merge the role hook
# into it instead of passing a second flag.
args=()
merged=0
while (($#)); do
  case "$1" in
    --settings|--settings=*)
      if [[ "$1" == --settings ]]; then value="${2-}"; shift 2 || shift; else value="${1#--settings=}"; shift; fi
      if [[ "$value" != \{* && -r "$value" ]]; then value="$(<"$value")"; fi
      value=$(/usr/bin/jq -c --argjson role "$role_settings" \
        '.hooks.SessionStart = ((.hooks.SessionStart // []) + $role.hooks.SessionStart)
         | .enabledPlugins = ((.enabledPlugins // {}) + ($role.enabledPlugins // {}))
         | .skillOverrides = ((.skillOverrides // {}) + ($role.skillOverrides // {}))
         | if $role.disableBundledSkills then .disableBundledSkills = true else . end' <<<"$value")
      args+=(--settings "$value")
      merged=1
      ;;
    *) args+=("$1"); shift ;;
  esac
done
((merged)) || args+=(--settings "$role_settings")

# Always use the Claude subscription login, never a third-party gateway.
unset ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN ANTHROPIC_API_KEY

claude_bin="${CLAUDE_BIN:-$(command -v claude || echo "${HOME}/.local/bin/claude")}"
exec "$claude_bin" ${args[@]+"${args[@]}"}
