{
  "room-lead": {
    "extends": "codex",
    "label": "Room Lead",
    "description": "Lead seat: Codex (ChatGPT subscription) in an isolated Codex Room runtime",
    "command": [
      "@@HOME@@/.local/bin/codex-room",
      "lead"
    ],
    "params": {
      "sandbox_mode": "danger-full-access",
      "approval_policy": "never"
    },
    "models": [
      {
        "id": "gpt-6-astra",
        "label": "Astra Medium",
        "isDefault": true,
        "thinkingOptions": [
          {
            "id": "medium",
            "label": "Medium",
            "isDefault": true
          },
          {
            "id": "high",
            "label": "High"
          }
        ]
      },
      {
        "id": "gpt-6.1-sol",
        "label": "Sol 6.1",
        "thinkingOptions": [
          {
            "id": "medium",
            "label": "Medium",
            "isDefault": true
          },
          {
            "id": "high",
            "label": "High"
          },
          {
            "id": "xhigh",
            "label": "Extra high"
          }
        ]
      }
    ],
    "paseoTools": {
      "enabled": true
    }
  },
  "room-lead-claude": {
    "extends": "claude",
    "label": "Room Lead (Claude)",
    "description": "Lead seat: Claude Code (Anthropic subscription) with room orchestration tools",
    "command": [
      "@@HOME@@/.local/bin/claude-room",
      "lead"
    ],
    "models": [
      {
        "id": "claude-opus-5-5",
        "label": "Opus 5.5",
        "isDefault": true,
        "thinkingOptions": [
          {
            "id": "high",
            "label": "High",
            "isDefault": true
          },
          {
            "id": "xhigh",
            "label": "Extra high"
          },
          {
            "id": "medium",
            "label": "Medium"
          }
        ]
      }
    ],
    "paseoTools": {
      "enabled": true
    }
  },
  "room-peer": {
    "extends": "acp",
    "label": "Room Peer",
    "description": "Peer seat: Kiro CLI (Opus 4.5), one bounded outcome, no orchestration tools",
    "command": [
      "@@KIRO_CLI@@",
      "acp",
      "--agent",
      "room-peer",
      "--model",
      "claude-opus-4.5",
      "--trust-all-tools"
    ],
    "models": [
      {
        "id": "claude-opus-4.5",
        "label": "Opus 4.5",
        "isDefault": true
      }
    ],
    "paseoTools": {
      "enabled": false
    }
  },
  "room-peer-minimax": {
    "extends": "opencode",
    "label": "Room Peer (MiniMax)",
    "description": "Opt-in Peer seat: OpenCode with MiniMax M3.1 Flash Preview, no orchestration tools",
    "env": {
      "OPENCODE_CONFIG_DIR": "@@HOME@@/.config/codex-room/opencode-peer"
    },
    "models": [
      {
        "id": "minimax-coding-plan/MiniMax-M3.1-Flash-Preview",
        "label": "MiniMax M3.1 Flash Preview",
        "isDefault": true
      }
    ],
    "paseoTools": {
      "enabled": false
    }
  }
}
