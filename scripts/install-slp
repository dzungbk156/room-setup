#!/usr/bin/env python3
"""Install the multi-provider SLP room profiles.

Supervisor -> Claude Code (claude-room), Lead -> Codex (codex-room),
Peer -> Kiro CLI (room-peer agent). Does not build or replace Paseo, and does
not touch ~/.codex, ~/.claude, or Kiro auth. Every replaced file is backed up.

usage: scripts/install-slp [--apply] [--force]   (default: dry run)

Installed files edited outside this repo are detected (via a hash manifest of
the last install) and never overwritten without --force; port such edits into
home/ first.
"""

import datetime
import hashlib
import json
import os
import pathlib
import shutil
import subprocess
import sys

REPO = pathlib.Path(__file__).resolve().parent.parent
HOME = pathlib.Path.home()
SRC = REPO / "home"

# (source relative to home/, destination relative to $HOME, render @@HOME@@, executable)
FILES = [
    (".config/codex-room/model-instructions.md", None, False, False),
    (".config/codex-room/workflow/WORKSPACE_PROTOCOL.md", None, False, False),
    (".config/codex-room/overlays/lead.config.toml", None, False, False),
    (".config/codex-room/roles/supervisor.md", None, False, False),
    (".config/codex-room/roles/peer.md", None, False, False),
    (".local/bin/codex-room", None, False, True),
    (".local/bin/codex-room-sync", None, False, True),
    (".local/bin/claude-room", None, False, True),
    (".kiro/agents/room-peer.json", None, True, False),
]
PROVIDERS_TEMPLATE = REPO / "paseo" / "room-providers.json.template"
PROFILES = REPO / "paseo" / "room-profiles.json"
PASEO_CONFIG = HOME / ".paseo" / "config.json"
MANIFEST = HOME / ".config" / "codex-room" / ".install-slp-manifest.json"
REQUIRED_BINS = ["codex", "claude", "kiro-cli"]
# Providers that must not receive Paseo orchestration tools once injection is on.
NON_ROOM_PROVIDERS = ["claude", "codex", "opencode", "copilot", "pi", "omp", "kiro"]


def render(text: str) -> str:
    return text.replace("@@HOME@@", str(HOME))


def digest(text: str) -> str:
    return hashlib.sha256(text.encode()).hexdigest()


def main() -> None:
    apply = "--apply" in sys.argv[1:]
    force = "--force" in sys.argv[1:]
    manifest = json.loads(MANIFEST.read_text()) if MANIFEST.exists() else {}
    drifted = []
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    backup_root = HOME / ".codex-room-backups" / f"slp-{stamp}"

    missing = [b for b in REQUIRED_BINS if not shutil.which(b)]
    if missing:
        raise SystemExit(f"missing required commands on PATH: {', '.join(missing)}")
    if not (HOME / ".codex" / "config.toml").exists():
        raise SystemExit("~/.codex/config.toml not found; install and log in to Codex first")

    def backup(path: pathlib.Path) -> None:
        if path.exists() or path.is_symlink():
            dest = backup_root / path.relative_to(HOME)
            dest.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(path, dest, follow_symlinks=False)

    for rel, dest_rel, do_render, executable in FILES:
        src = SRC / rel
        dest = HOME / (dest_rel or rel)
        content = src.read_text()
        if do_render:
            content = render(content)
        key = str(dest.relative_to(HOME))
        if dest.exists() and dest.read_text() == content:
            print(f"unchanged  ~/{key}")
            manifest[key] = digest(content)
            continue
        if dest.exists() and key in manifest and digest(dest.read_text()) != manifest[key] and not force:
            print(f"DRIFTED    ~/{key}  (edited since last install; not overwritten)")
            drifted.append(key)
            continue
        print(f"{'write' if apply else 'would write'}  ~/{dest.relative_to(HOME)}")
        if apply:
            backup(dest)
            dest.parent.mkdir(parents=True, exist_ok=True)
            dest.write_text(content)
            if executable:
                dest.chmod(0o755)
            manifest[key] = digest(content)

    providers = json.loads(render(PROVIDERS_TEMPLATE.read_text()))
    config = json.loads(PASEO_CONFIG.read_text()) if PASEO_CONFIG.exists() else {"version": 1}
    existing = config.setdefault("agents", {}).setdefault("providers", {})
    for provider_id, spec in providers.items():
        state = "unchanged" if existing.get(provider_id) == spec else ("update" if provider_id in existing else "add")
        print(f"{state if apply or state == 'unchanged' else 'would ' + state}  paseo provider {provider_id}")
        existing[provider_id] = spec
    for provider_id in NON_ROOM_PROVIDERS:
        entry = existing.setdefault(provider_id, {})
        if "paseoTools" not in entry:
            print(f"{'set' if apply else 'would set'}  paseo provider {provider_id} paseoTools.enabled = false")
            entry["paseoTools"] = {"enabled": False}
    profiles = config.setdefault("daemon", {}).setdefault("agentProfiles", [])
    for profile in json.loads(PROFILES.read_text()):
        idx = next((i for i, p in enumerate(profiles) if p.get("id") == profile["id"]), None)
        if idx is not None and profiles[idx] == profile:
            print(f"unchanged  paseo profile {profile['id']}")
            continue
        print(f"{'' if apply else 'would '}{'update' if idx is not None else 'add'}  paseo profile {profile['id']}")
        if idx is None:
            profiles.append(profile)
        else:
            profiles[idx] = profile
    mcp = config.setdefault("daemon", {}).setdefault("mcp", {})
    if mcp.get("enabled") is not True or mcp.get("injectIntoAgents") is not True:
        print(f"{'set' if apply else 'would set'}  daemon.mcp.enabled/injectIntoAgents = true")
        mcp.update({"enabled": True, "injectIntoAgents": True})
    if drifted:
        print("\nSome installed files were edited outside the repo. Port those edits into"
              "\nhome/ (diff them against the repo copy), or re-run with --force to overwrite.")
    if apply:
        MANIFEST.parent.mkdir(parents=True, exist_ok=True)
        MANIFEST.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n")
        backup(PASEO_CONFIG)
        PASEO_CONFIG.parent.mkdir(parents=True, exist_ok=True)
        tmp = PASEO_CONFIG.with_suffix(".json.tmp")
        tmp.write_text(json.dumps(config, indent=2) + "\n")
        os.replace(tmp, PASEO_CONFIG)

        subprocess.run([str(HOME / ".local/bin/codex-room-sync"), "lead"], check=True)
        print("synced     ~/.codex-runtime/lead")
        if backup_root.exists():
            backup_root.chmod(0o700)
            print(f"backups    {backup_root}")
        print("\nNext: restart the Paseo daemon so MCP injection and providers apply:  paseo restart")
    else:
        print("\nDry run only. Re-run with --apply to install.")


if __name__ == "__main__":
    main()
